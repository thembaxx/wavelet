{
  "name": "wavelet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/generate-service-worker.mjs",
    "start": "next start",
    "lint": "oxlint . && npm run lint:rules",
    "clean": "next clean",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "feedback:collect": "FEEDBACK_OUTPUT=.feedback/events.jsonl node --experimental-strip-types --test lib/feedback-smoke.test.ts",
    "feedback:review": "node scripts/review-feedback.mjs",
    "feedback:daily": "bun run feedback:collect && bun run feedback:review",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:rules": "eslint --config eslint.rules.config.mjs firestore.rules"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@types/three": "^0.186.0",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "firebase-tools": "^15.34.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
