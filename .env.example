# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Optional Spotify Web API OAuth credentials
# Used to connect user Spotify accounts and generate game rounds from their top tracks/artists.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# APPLE_MUSIC_DEVELOPER_TOKEN: Optional Apple MusicKit JS developer token
# Used for personalized Apple Music library integration and playlist export.
APPLE_MUSIC_DEVELOPER_TOKEN=""


# Canonical public origin for metadata, sitemap, and social previews.
# Defaults to the published Wavelet site if not set.
NEXT_PUBLIC_SITE_URL="https://wavelet-azure.vercel.app"

# Cloudflare PartyServer Worker origin, for the optional Play with friends mode.
# Example: https://wavelet-multiplayer.<your-workers-subdomain>.workers.dev
# Set this in Vercel after deploying workers/multiplayer.
NEXT_PUBLIC_WAVELET_MULTIPLAYER_URL=""
